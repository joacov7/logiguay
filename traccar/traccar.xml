<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <!-- Base de datos embebida H2 (suficiente para empezar; migrar a PostgreSQL en producción) -->
    <entry key="database.driver">org.h2.Driver</entry>
    <entry key="database.url">jdbc:h2:./data/database</entry>
    <entry key="database.user">sa</entry>
    <entry key="database.password"></entry>

    <!-- El resto de la config (forward.*) llega por variables de entorno desde docker-compose -->
    <entry key="config.useEnvironmentVariables">true</entry>

    <!-- Registrar dispositivos automáticamente cuando reportan por primera vez -->
    <entry key="database.registerUnknown">true</entry>

    <!-- Protocolo Concox/GT06 (West A10 y similares) en puerto 5023 -->
    <entry key="concox.port">5023</entry>
    <!-- GT06 es variante del mismo protocolo, algunos West A10 lo usan -->
    <entry key="gt06.port">5024</entry>
</properties>
