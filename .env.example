# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=logiguay
POSTGRES_PASSWORD=logiguay_pass
POSTGRES_DB=logiguay_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_super_secret_refresh_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development

# ─── Next.js / Web ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ─── PgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@logiguay.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ─── Storage (S3 compatible) ─────────────────────────────────────────────────
S3_BUCKET=logiguay-docs
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=https://s3.amazonaws.com

# ─── Mail ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=noreply@logiguay.com

# ─── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
