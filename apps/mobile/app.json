{
  "expo": {
    "name": "LOGIGUAY",
    "slug": "logiguay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "logiguay",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F0F0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.logiguay.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LOGIGUAY usa tu ubicación para el seguimiento de viajes en tiempo real.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "LOGIGUAY usa tu ubicación en segundo plano para seguir el viaje aunque la app esté minimizada.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.logiguay.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15A66A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LOGIGUAY usa tu ubicación para el seguimiento de viajes en tiempo real.",
          "locationWhenInUsePermission": "LOGIGUAY usa tu ubicación para el seguimiento de viajes en tiempo real.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      ["expo-notifications", { "sounds": [] }]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
