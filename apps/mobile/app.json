{
  "expo": {
    "name": "LOGIGUAY",
    "slug": "logiguay",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": { "resizeMode": "contain", "backgroundColor": "#1e3a8a" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.logiguay.app" },
    "android": { "adaptiveIcon": { "backgroundColor": "#1e3a8a" }, "package": "com.logiguay.app" },
    "plugins": [
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "LOGIGUAY necesita tu ubicación para el seguimiento de viajes." }],
      ["expo-notifications", { "sounds": [] }]
    ],
    "scheme": "logiguay"
  }
}
